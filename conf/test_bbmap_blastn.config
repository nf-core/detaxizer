/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running bbmap + blastn test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and configuration to test bbmap filterbyname with blastn validation.

    Use as follows:
        nextflow run nf-core/detaxizer -profile test_bbmap_blastn,<docker/singularity> --outdir <OUTDIR>

-----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for bbmap filtering with blastn validation'
    config_profile_description = 'Test pipeline when using bbmap filterbyname with blastn validation'

    // Input data
    input                            = params.pipelines_testdata_base_path + "detaxizer/samplesheets/samplesheet_bbmap_blastn.csv"

    // Kraken2 test db
    kraken2db                        = params.pipelines_testdata_base_path + "detaxizer/test_data/minigut_kraken.tgz"
    kraken2confidence                = 0.00
    tax2filter                       = 'unclassified'

    // Genome references
    fasta_blastn                     = params.pipelines_testdata_base_path + "detaxizer/host_reference/genome.hg38.chr21_10000bp_region.fa"

    // Workflow parameters
    validation_blastn                = true
    filtering_tool                   = 'bbmap'

    // Output also the removed reads so the test can count how many reads were removed
    output_removed_reads             = true

    // samplesheet generation
    generate_downstream_samplesheets = true
    generate_pipeline_samplesheets   = "taxprofiler,mag"
}
